GOVINSIGHT_APP_ENV=development
GOVINSIGHT_LOG_LEVEL=INFO
GOVINSIGHT_POSTGRES_DB=govinsight
GOVINSIGHT_POSTGRES_USER=govinsight_app
GOVINSIGHT_POSTGRES_PASSWORD=replace-with-a-local-secret
GOVINSIGHT_POSTGRES_HOST=localhost
GOVINSIGHT_POSTGRES_PORT=5432
GOVINSIGHT_POSTGRES_POOL_SIZE=5
GOVINSIGHT_POSTGRES_MAX_OVERFLOW=10
GOVINSIGHT_POSTGRES_POOL_RECYCLE_SECONDS=300
# Production only: pooled, read-only URL with sslmode=require
# GOVINSIGHT_DATABASE_DSN=
GOVINSIGHT_AGENT_PROVIDER=rules
# GOVINSIGHT_OPENAI_API_KEY=
# GOVINSIGHT_OPENAI_MODEL=
GOVINSIGHT_OPENAI_TIMEOUT_SECONDS=12
GOVINSIGHT_AGENT_FALLBACK_ENABLED=true
GOVINSIGHT_PNCP_BASE_URL=https://pncp.gov.br/api/consulta
GOVINSIGHT_PNCP_TIMEOUT_SECONDS=30
GOVINSIGHT_PNCP_RETRY_MAX_ATTEMPTS=4
GOVINSIGHT_PNCP_RETRY_BASE_DELAY_SECONDS=0.5
GOVINSIGHT_PNCP_RETRY_MAX_DELAY_SECONDS=8
